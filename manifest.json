{
  "manifest_version": 3,
  "name": "Web Voyager",
  "version": "1.0",
  "description": "An intelligent web agent.",
  "permissions": ["activeTab", "tabs", "storage"],
  "options_page": "options.html",
  "background": {
    "service_worker": "dist/background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["dist/content.js"]
    }
  ],
  "action": {
    "default_popup": "popup.html"
  }
}
